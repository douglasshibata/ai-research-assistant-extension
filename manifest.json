{
  "manifest_version": 3,
  "name": "AI Research Assistant",
  "version": "1.0.0",
  "description": "Highlight text and ask AI questions about the page content.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Research Assistant"
  }
}
